    "version": "0.2.0",
    "configurations": [

        {
            "name": "serum_app_front",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define-from-file",
                "secrets.json"
            ]
        },
        {
            "name": "serum_app_front (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "serum_app_front (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "serum_business",
            "cwd": "packages\\serum_business",
            "request": "launch",
            "type": "dart"
        }
    ]
}